# ===========================================================================
#  .env.example  =  SABLON (acesta SE urca in git; .env real NU)
# ---------------------------------------------------------------------------
#  Copiaza acest fisier in ".env" si completeaza cookie-ul tau de sesiune.
#  Vezi instructiunile din .env / handoff.md.
# ===========================================================================

# Sirul de cookie-uri de sesiune, pe o singura linie:
#   sl-session=...; SELF_UTI=...
ACI_SESSION_COOKIE=

# Cod client si numar contract (necesare pentru endpoint-urile reale).
# Le gasesti in portal sau pe factura. Exemplu: 1234 si 20.
ACI_COD_CLIENT=
ACI_NR_CONTRACT=
