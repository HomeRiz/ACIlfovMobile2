<?xml version="1.0" encoding="utf-8"?>
<!-- Interzice traficul HTTP necriptat si accepta doar CA-urile de sistem. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
